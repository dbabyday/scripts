<?xml version="1.0" encoding="utf-8" ?>
<CodeSnippets  xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
<_locDefinition xmlns="urn:locstudio">
    <_locDefault _loc="locNone" />
    <_locTag _loc="locData">Title</_locTag>
    <_locTag _loc="locData">Description</_locTag>
    <_locTag _loc="locData">Author</_locTag>
    <_locTag _loc="locData">ToolTip</_locTag>
</_locDefinition>
	<CodeSnippet Format="1.0.0">
		<Header>
			<Title>ConversionValueFromMB</Title>
			<Shortcut></Shortcut>
			<Description></Description>
			<Author>dbabyday</Author>
			<SnippetTypes>
				<SnippetType>Expansion</SnippetType>
			</SnippetTypes>
		</Header>
		<Snippet>
			<Code Language="SQL"><![CDATA[
DECLARE @DisplayUnits VARCHAR(2) = 'GB';  /* KB, MB, GB, TB */


/* set the size conversion value based on the desired units */
DECLARE @ConversionValueFromMB DECIMAL(26,10);
IF      @DisplayUnits = 'KB' SET @ConversionValueFromMB = 1.0000000000 / 1024.0;
ELSE IF @DisplayUnits = 'MB' SET @ConversionValueFromMB = 1.0;
ELSE IF @DisplayUnits = 'GB' SET @ConversionValueFromMB = 1024.0;
ELSE IF @DisplayUnits = 'TB' SET @ConversionValueFromMB = 1024.0 * 1024.0;
]]>
			</Code>
		</Snippet>
	</CodeSnippet>
</CodeSnippets>
