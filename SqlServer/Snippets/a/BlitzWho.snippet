<?xml version="1.0" encoding="utf-8" ?>
<CodeSnippets  xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
<_locDefinition xmlns="urn:locstudio">
    <_locDefault _loc="locNone" />
    <_locTag _loc="locData">Title</_locTag>
    <_locTag _loc="locData">Description</_locTag>
    <_locTag _loc="locData">Author</_locTag>
    <_locTag _loc="locData">ToolTip</_locTag>
</_locDefinition>
	<CodeSnippet Format="1.0.0">
		<Header>
			<Title>BlitzWho</Title>
			<Shortcut></Shortcut>
			<Description>sp_BlitzFirst @ExpertMode=1, @Seconds=60</Description>
			<Author>dbabyday</Author>
			<SnippetTypes>
				<SnippetType>Expansion</SnippetType>
			</SnippetTypes>
		</Header>
		<Snippet>
			<Declarations>
                <Literal>
                	<ID>ServerName</ID>
                	<ToolTip>Name of the server to execute on</ToolTip>
                    <Default>WNEEL31146</Default>
                </Literal>
			</Declarations>
			<Code Language="SQL"><![CDATA[
/* EMERGENCY - fast and light weight 

*/

EXECUTE sp_WhoIsActive;

/*

--Filters--Both inclusive and exclusive
--Set either filter to '' to disable
--Valid filter types are: session, program, database, login, and host
--Session is a session ID, and either 0 or '' can be used to indicate "all" sessions
--All other filter types support % or _ as wildcards

	  @filter_type VARCHAR(10) = 'session'
	, @filter sysname = ''

	  @not_filter_type VARCHAR(10) = 'session'
	, @not_filter sysname = ''


-- Look at all my sessions
EXECUTE sp_WhoIsActive
	@filter = N'NA\james.lutsey.admin',
	@filter_type = N'login',
	@show_sleeping_spids = 2;


-- More info 
EXECUTE sp_BlitzWho @ShowSleepingSpids=1, @ExpertMode=1;

*/
]]>
			</Code>
		</Snippet>
	</CodeSnippet>
</CodeSnippets>
