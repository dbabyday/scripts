<?xml version="1.0" encoding="utf-8" ?>
<CodeSnippets  xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
	<_locDefinition xmlns="urn:locstudio">
	    <_locDefault _loc="locNone" />
	    <_locTag _loc="locData">Title</_locTag>
	    <_locTag _loc="locData">Description</_locTag>
	    <_locTag _loc="locData">Author</_locTag>
	    <_locTag _loc="locData">ToolTip</_locTag>
	</_locDefinition>
	<CodeSnippet Format="1.0.0">
		<Header>
			<Title>CursorTemplate</Title>
                <Shortcut></Shortcut>
			<Description>Template for a cursor</Description>
			<Author>dbabyday</Author>
			<SnippetTypes>
                <SnippetType>Expansion</SnippetType>
			</SnippetTypes>
		</Header>
		<Snippet>
			<Declarations>
                <Literal>
                	<ID>CursorName</ID>
                	<ToolTip>Name of the cursor</ToolTip>
                    <Default>cur_Template</Default>
                </Literal>
                <Literal>
                	<ID>Variables</ID>
                	<ToolTip>List of the variables the cursor will select into</ToolTip>
                    <Default>@variable01, @variable02</Default>
                </Literal>
            </Declarations>
			<Code Language="SQL"><![CDATA[

DECLARE $Variables$;

DECLARE $CursorName$ CURSOR LOCAL FAST_FORWARD FOR
	/* Query */

OPEN $CursorName$;
	FETCH NEXT FROM $CursorName$ INTO $Variables$;

	WHILE @@FETCH_STATUS = 0
	BEGIN
		/* Do your work here */

		FETCH NEXT FROM $CursorName$ INTO $Variables$;
	END;
CLOSE $CursorName$;
DEALLOCATE $CursorName$;

]]>
            </Code>
		</Snippet>
	</CodeSnippet>
</CodeSnippets>
